{"kind": "cell", "engine": "voxcpm2", "qid": "q22", "rep": 1, "group": "5 语气与情感", "text_chars": 20, "text": "你听一下这段，是不是有点像我自己的声音？", "wall_s": 155.325, "audio_s": 4.32, "sr": 48000, "rtf": 35.955, "cold_load_s": null, "ok": true, "note": "OK sr=48000 dur=4.32s rms=0.1187", "path": "D:/study/ai-jms/voice_samples/ep25_run\\slot_0015\\audio\\voxcpm2\\q22_rep1.wav", "ts": "04:36:04"}
